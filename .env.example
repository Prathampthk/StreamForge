# Local development credentials only. Copy to .env before startup.
POSTGRES_PASSWORD=streamforge_local_only
CLICKHOUSE_PASSWORD=streamforge_local_only

# Local-only demo ingestion key. Must be at least 24 bytes.
INGEST_API_KEY=streamforge_demo_key_local_only_change_me
INGEST_TENANT=merchant_demo
TRACE_SAMPLE_RATIO=0.1
# Optional http(s) OTLP collector endpoint; no exporter if empty.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Consumer Compose supplies internal broker/database origins.
CONSUMER_GROUP=streamforge-sink-v1
# Host-run consumer options (load/export env yourself):
# CLICKHOUSE_URL=http://localhost:8123
# CLICKHOUSE_USER=streamforge
# CONSUMER_HTTP_ADDR=127.0.0.1:8081
# See docs/consumer.md for validated batching/retry/deadline settings.

# Query key is separate from the ingestion key; local examples only.
QUERY_API_KEY=streamforge_query_demo_key_local_only
QUERY_TENANT=merchant_demo
# Optional observability stack; Grafana login admin / this local-only password.
GRAFANA_ADMIN_PASSWORD=streamforge_grafana_local_only
# Query limits/defaults are documented in docs/query.md.
