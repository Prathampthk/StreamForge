    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Producer failures by bounded class",
      "gridPos": {
        "x": 16,
        "y": 28,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (class) (rate(streamforge_producer_errors_total[1m]))",
