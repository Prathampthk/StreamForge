      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance)(streamforge_consumer_partition_assigned)",
          "legendFormat": "{{kind}} {{outcome}} {{instance}}"
