{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamforge.local/schemas/event-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "tenant_id",
    "user_id",
    "event_type",
    "occurred_at"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "user_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "order_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "enum": [
        "page_view",
        "add_to_cart",
        "purchase",
        "api_request"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "amount_cents": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        {
          "type": "null"
        }
      ]
    },
    "currency": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status_code": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        {
          "type": "null"
        }
      ]
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 3,
      "properties": {
        "source": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]*$"
        },
        "device": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]*$"
        },
        "campaign": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]*$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "purchase"
          }
        }
      },
      "then": {
        "required": [
          "order_id",
          "amount_cents",
          "currency"
        ],
        "properties": {
          "order_id": {
            "not": {
              "type": "null"
            }
          },
          "amount_cents": {
            "not": {
              "type": "null"
            }
          },
          "currency": {
            "not": {
              "type": "null"
            }
          },
          "status_code": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "api_request"
          }
        }
      },
      "then": {
        "required": [
          "status_code"
        ],
        "properties": {
          "status_code": {
            "not": {
              "type": "null"
            }
          },
          "order_id": {
            "type": "null"
          },
          "amount_cents": {
            "type": "null"
          },
          "currency": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "page_view",
              "add_to_cart"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "order_id": {
            "type": "null"
          },
          "amount_cents": {
            "type": "null"
          },
          "currency": {
            "type": "null"
          },
          "status_code": {
            "type": "null"
          }
        }
      }
    }
  ]
}
